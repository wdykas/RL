ARG python
ARG research/thundersync_rl/run_thundersync_grpo.py
ARG --config
ARG research/thundersync_rl/configs/paper/ts.yaml
ARG --history-json
ARG {OUT_ROOT}/paper-ts-super-l22-gate-layout/history.json
ARG logger.log_dir={OUT_ROOT}/paper-ts-super-l22-gate-layout/logs
ARG policy.model_name={W}/models/nemotron3-super-L22
ARG grpo.max_num_steps=32
ARG grpo.num_prompts_per_step=64
ARG grpo.num_generations_per_prompt=8
ARG policy.train_global_batch_size=512
ARG policy.max_total_sequence_length=10240
ARG data.max_input_seq_length=2048
ARG policy.generation.max_new_tokens=8192
ARG cluster.num_nodes=3
ARG cluster.gpus_per_node=4
ARG policy.generation.colocated.resources.num_nodes=1
ARG policy.generation.colocated.resources.gpus_per_node=4
ARG policy.megatron_cfg.tensor_model_parallel_size=2
ARG policy.megatron_cfg.pipeline_model_parallel_size=1
ARG policy.megatron_cfg.expert_model_parallel_size=8
ARG policy.megatron_cfg.sequence_parallel=true
ARG ++policy.generation.mcore_generation_config.tensor_model_parallel_size=2
ARG ++policy.generation.mcore_generation_config.pipeline_model_parallel_size=1
ARG ++policy.generation.mcore_generation_config.expert_model_parallel_size=4
ARG ++policy.megatron_cfg.moe_ep_invariant_combine=true
ARG grpo.seed=42
ARG ++thundersync.cohort_lanes=2
ENV NEMO_RL_PY_EXECUTABLES_SYSTEM=1
ENV NVIDIA_TF32_OVERRIDE=1
ENV RAY_DEDUP_LOGS=0
ENV THUNDERSYNC_DEBUG_PARITY_REWARD=1
ENV THUNDERSYNC_MISMATCH_ROW_REPORT=1
ENV THUNDERSYNC_RUN_DIR={OUT_ROOT}/paper-ts-super-l22-gate-layout
