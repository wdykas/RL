ARG python
ARG research/thundersync_rl/run_thundersync_grpo.py
ARG --config
ARG research/thundersync_rl/configs/ab/ab_async4.yaml
ARG --history-json
ARG {OUT_ROOT}/async4-nemotron3-nano-L8-tp1-pp1-ep4-L8192-s8-p16-nl8-lk-k4a/history.json
ARG logger.log_dir={OUT_ROOT}/async4-nemotron3-nano-L8-tp1-pp1-ep4-L8192-s8-p16-nl8-lk-k4a/logs
ARG policy.model_name={W}/models/nemotron3-nano-L8
ARG grpo.max_num_steps=8
ARG grpo.num_prompts_per_step=16
ARG grpo.num_generations_per_prompt=8
ARG policy.train_global_batch_size=128
ARG policy.max_total_sequence_length=10240
ARG data.max_input_seq_length=2048
ARG policy.generation.max_new_tokens=8192
ARG cluster.num_nodes=2
ARG cluster.gpus_per_node=4
ARG policy.generation.colocated.resources.num_nodes=1
ARG policy.generation.colocated.resources.gpus_per_node=1
ARG ++policy.generation.colocated.resources.allow_partial_node=true
ARG policy.megatron_cfg.tensor_model_parallel_size=1
ARG policy.megatron_cfg.pipeline_model_parallel_size=1
ARG policy.megatron_cfg.expert_model_parallel_size=4
ARG policy.megatron_cfg.sequence_parallel=false
ARG ++policy.generation.mcore_generation_config.tensor_model_parallel_size=1
ARG ++policy.generation.mcore_generation_config.pipeline_model_parallel_size=1
ARG ++policy.generation.mcore_generation_config.expert_model_parallel_size=1
ARG ++policy.megatron_cfg.env_vars.THUNDERSYNC_LEARNER_PROF='1'
ARG ++policy.megatron_cfg.env_vars.THUNDERSYNC_ENGINE_PROF='1'
ARG ++policy.megatron_cfg.env_vars.NEMO_RL_MOE_DEVICE_DISPATCH='1'
ARG ++policy.megatron_cfg.env_vars.NEMO_RL_MOE_DEVICE_DISPATCH_TOKENS='20480'
ARG ++policy.megatron_cfg.env_vars.NEMO_RL_MOE_DEVICE_DISPATCH_CAPACITY='2.0'
ARG ++policy.megatron_cfg.env_vars.NEMO_RL_LEARNER_DEFER_METRICS='1'
ARG ++policy.megatron_cfg.env_vars.NEMO_RL_LEARNER_GRAPHS_SHARED_POOL='0'
ARG ++policy.megatron_cfg.moe_ep_invariant_combine=true
ARG grpo.seed=42
ARG ++thundersync.cohort_lanes=4
ARG ++policy.generation.mcore_generation_config.cuda_graph_all_prefills=true
ARG ++thundersync.short_fillers=true
ARG ++thundersync.plain_engine_sampler=wide
ARG ++policy.generation.mcore_generation_config.buffer_size_gb=24
ARG policy.megatron_cfg.optimizer.lr=3.0e-4
ARG policy.megatron_cfg.optimizer.min_lr=3.0e-4
ARG ++policy.generation.mcore_generation_config.max_requests=512
ENV NEMO_RL_LEARNER_GRAPHS_SHARED_POOL=0
ENV NEMO_RL_MOE_DEVICE_DISPATCH=1
ENV NEMO_RL_MOE_DEVICE_DISPATCH_CAPACITY=2.0
ENV NEMO_RL_MOE_DEVICE_DISPATCH_TOKENS=20480
ENV NEMO_RL_PY_EXECUTABLES_SYSTEM=1
ENV NVIDIA_TF32_OVERRIDE=1
ENV RAY_DEDUP_LOGS=0
ENV THUNDERSYNC_DEBUG_KEYED_FRESH=1
ENV THUNDERSYNC_DEBUG_PARITY_REWARD=1
ENV THUNDERSYNC_ENGINE_PROF=1
ENV THUNDERSYNC_MISMATCH_ROW_REPORT=1
ENV THUNDERSYNC_RUN_DIR={OUT_ROOT}/async4-nemotron3-nano-L8-tp1-pp1-ep4-L8192-s8-p16-nl8-lk-k4a
ENV THUNDERSYNC_STEP_DIGEST=1
