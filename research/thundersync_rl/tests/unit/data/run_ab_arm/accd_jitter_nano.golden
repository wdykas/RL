ARG python
ARG research/thundersync_rl/run_thundersync_grpo.py
ARG --config
ARG research/thundersync_rl/configs/ab/ab_ts_scale.yaml
ARG --history-json
ARG {OUT_ROOT}/ts_scale-NVIDIA-Nemotron-3-Nano-30B-A3B-BF16-tp1-pp1-ep4-L8192-s21-p64-ns4-8k-ts-s43-accd-jitter/history.json
ARG logger.log_dir={OUT_ROOT}/ts_scale-NVIDIA-Nemotron-3-Nano-30B-A3B-BF16-tp1-pp1-ep4-L8192-s21-p64-ns4-8k-ts-s43-accd-jitter/logs
ARG policy.model_name=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B-BF16
ARG grpo.max_num_steps=21
ARG grpo.num_prompts_per_step=64
ARG grpo.num_generations_per_prompt=8
ARG policy.train_global_batch_size=512
ARG policy.max_total_sequence_length=10240
ARG data.max_input_seq_length=2048
ARG policy.generation.max_new_tokens=8192
ARG cluster.num_nodes=3
ARG cluster.gpus_per_node=4
ARG policy.generation.colocated.resources.num_nodes=1
ARG policy.generation.colocated.resources.gpus_per_node=4
ARG policy.megatron_cfg.tensor_model_parallel_size=1
ARG policy.megatron_cfg.pipeline_model_parallel_size=1
ARG policy.megatron_cfg.expert_model_parallel_size=4
ARG policy.megatron_cfg.sequence_parallel=false
ARG ++policy.generation.mcore_generation_config.tensor_model_parallel_size=1
ARG ++policy.generation.mcore_generation_config.pipeline_model_parallel_size=1
ARG ++policy.generation.mcore_generation_config.expert_model_parallel_size=4
ARG ++policy.megatron_cfg.env_vars.THUNDERSYNC_LEARNER_PROF='1'
ARG ++policy.megatron_cfg.env_vars.THUNDERSYNC_ENGINE_PROF='1'
ARG ++policy.megatron_cfg.env_vars.NEMO_RL_MOE_DEVICE_DISPATCH='1'
ARG ++policy.megatron_cfg.env_vars.NEMO_RL_MOE_DEVICE_DISPATCH_TOKENS='20480'
ARG ++policy.megatron_cfg.env_vars.NEMO_RL_MOE_DEVICE_DISPATCH_CAPACITY='2.0'
ARG ++policy.megatron_cfg.env_vars.NEMO_RL_LEARNER_DEFER_METRICS='1'
ARG ++policy.megatron_cfg.env_vars.NEMO_RL_LEARNER_GRAPHS_SHARED_POOL='0'
ARG ++thundersync.verify0_batch_tokens=20480
ARG ++policy.megatron_cfg.env_vars.THUNDERSYNC_TRAIN_LP_CHECK='1'
ARG ++policy.megatron_cfg.env_vars.THUNDERSYNC_LAW_CHECK='1'
ARG grpo.seed=43
ARG checkpointing.enabled=true
ARG checkpointing.checkpoint_dir={W}/runs_ab/ckpt/ns4-8k-ts-s43-accd-jitter
ARG checkpointing.save_period=1000
ARG ++checkpointing.save_optimizer=true
ARG ++checkpointing.keep_top_k=1
ARG ++checkpointing.ft_keep_latest_k=1
ARG ++checkpointing.metric_name=null
ARG ++checkpointing.higher_is_better=true
ARG ++checkpointing.checkpoint_must_save_by=null
ARG ++policy.megatron_cfg.checkpoint.async_save=false
ARG ++thundersync.cohort_lanes=2
ARG ++thundersync.learner_prefix_cache=true
ARG ++thundersync.learner_prefix_cache_gpu_gb=4
ARG ++policy.megatron_cfg.env_vars.THUNDERSYNC_MASTER_JITTER='1'
ARG ++policy.megatron_cfg.env_vars.THUNDERSYNC_SPEC_PROF='1'
ENV NEMO_RL_LEARNER_GRAPHS_SHARED_POOL=0
ENV NEMO_RL_MOE_DEVICE_DISPATCH=1
ENV NEMO_RL_MOE_DEVICE_DISPATCH_CAPACITY=2.0
ENV NEMO_RL_MOE_DEVICE_DISPATCH_TOKENS=20480
ENV NEMO_RL_PY_EXECUTABLES_SYSTEM=1
ENV NVIDIA_TF32_OVERRIDE=1
ENV RAY_DEDUP_LOGS=0
ENV THUNDERSYNC_CHECK_EVERY=10
ENV THUNDERSYNC_CHECK_OFF_ENV=THUNDERSYNC_MISMATCH_CHECK=1,THUNDERSYNC_MISMATCH_CHECK_ROWS=16,THUNDERSYNC_LAW_CHECK=1,THUNDERSYNC_EMISSION_LAW_EVERY=4,THUNDERSYNC_TRAIN_LP_CHECK=1
ENV THUNDERSYNC_ENGINE_PREFILL_CHECK=1
ENV THUNDERSYNC_ENGINE_PREFILL_CHECK_ROWS=8
ENV THUNDERSYNC_ENGINE_PREFILL_CHECK_TOKENS=32768
ENV THUNDERSYNC_ENGINE_PROF=1
ENV THUNDERSYNC_ENGINE_Q_CHECK=1
ENV THUNDERSYNC_LAW_CHECK=1
ENV THUNDERSYNC_MISMATCH_CHECK=1
ENV THUNDERSYNC_ROUTE_CHECK_ROWS=16
ENV THUNDERSYNC_RUN_DIR={OUT_ROOT}/ts_scale-NVIDIA-Nemotron-3-Nano-30B-A3B-BF16-tp1-pp1-ep4-L8192-s21-p64-ns4-8k-ts-s43-accd-jitter
ENV THUNDERSYNC_TRAIN_LP_CHECK=1
